{
  "name": "context-capsule",
  "version": "0.1.0",
  "private": true,
  "description": "The AI only ever sees the messages you hand it — and you can see exactly what that is.",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @capsule/db migrate",
    "db:generate": "pnpm --filter @capsule/db generate"
  },
  "dependencies": {
    "next": "15.5.19"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "vitest": "^1.4.0"
  },
  "keywords": [
    "mcp",
    "slack",
    "ai",
    "context",
    "security",
    "model-context-protocol"
  ]
}
