# --- Database ---
DATABASE_URL=postgres://capsule:capsule@localhost:5432/capsule

# --- Redis (BullMQ + rate-limit token bucket) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (attachments, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=capsule
S3_SECRET_KEY=capsule-secret
S3_BUCKET=capsule-attachments
S3_REGION=us-east-1

# --- Envelope encryption (age recipient + identity for self-host) ---
# Generate with: age-keygen -o age.key   (then put the public recipient here)
CAPSULE_ENCRYPTION_RECIPIENT=age1examplerecipientpublickey...
CAPSULE_ENCRYPTION_IDENTITY=AGE-SECRET-KEY-1EXAMPLEIDENTITYPRIVATEKEY...

# --- Slack app ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=replace-with-32-byte-random

# Where Slack should reach the slack app (OAuth redirect + events endpoint)
PUBLIC_BASE_URL=http://localhost:3001

# --- Web app (Next.js) ---
WEB_BASE_URL=http://localhost:3000

# --- MCP server (remote, OAuth) ---
MCP_BASE_URL=http://localhost:3003
MCP_OAUTH_ISSUER=http://localhost:3000
MCP_OAUTH_AUDIENCE=capsule-mcp

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9464
LOG_LEVEL=info
